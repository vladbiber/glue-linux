if [ -x /sbin/agetty -o -x /bin/agetty ]; then
	# util-linux specific settings
	if [ "${tty}" = "tty1" ]; then
		# Glue live: log ROOT in automatically on tty1 (no username/
		# password prompt, '#' shell). The installer and every disk tool
		# need root anyway — starting as root means the install can never
		# fail on sudo/elevation. The login shell sources
		# /etc/profile.d/glue-live.sh, which launches the installer.
		GETTY_ARGS="--noclear --autologin root"
	fi
fi

BAUD_RATE=38400
TERM_NAME=linux
