if [ -x /sbin/agetty -o -x /bin/agetty ]; then
	# util-linux specific settings
	if [ "${tty}" = "tty1" ]; then
		# Glue live: log the `glue` user in automatically on tty1 (no
		# username/password prompt). The login shell sources
		# /etc/profile.d/glue-live.sh, which starts the live desktop (KMS) or
		# the text installer; glue-install self-elevates via sudoers.d/10-glue-live.
		GETTY_ARGS="--noclear --autologin glue"
	fi
fi

BAUD_RATE=38400
TERM_NAME=linux
