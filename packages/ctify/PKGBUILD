# Maintainer: Glue Linux
pkgname=ctify
pkgver=r0
pkgrel=1
pkgdesc="Lightweight music player written in C with SDL2"
arch=('x86_64')
url="https://github.com/vladbiber/ctify"
license=('MIT')
depends=('sdl2-compat' 'sdl2_ttf' 'sqlite' 'ttf-dejavu')
makedepends=('git')
source=("git+https://github.com/vladbiber/ctify.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$pkgname"
    make
}

package() {
    cd "$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
