#!/usr/bin/openrc-run
# glue-tuning - one-shot THP tuning at boot
description="Glue Linux THP tuning (oneshot)"

depend() {
    after localmount
}

start() {
    ebegin "Applying Glue THP tuning"
    /usr/lib/glue/keep-modules clean
    setsid sh -c '/usr/bin/glue-timesync --wait 300; exec /usr/bin/glue-flatpak-gl' </dev/null >/dev/null 2>&1 &
    /usr/bin/glue-thp-tune
    eend $?
}
