#!/bin/sh
# NetworkManager dispatcher: one line per link change in /var/log/glue-network.log,
# so a link that came up without a gateway leaves evidence (NM has no log without syslog)
log=${GLUE_NETLOG:-/var/log/glue-network.log}
case "$2" in
up|down|dhcp4-change|connectivity-change) ;;
*) exit 0 ;;
esac
{
    printf '%s %s %s gw=%s dhcp_routers=%s state=%s\n' "$(date '+%F %T')" "${1:--}" "$2" \
        "${IP4_GATEWAY:--}" "${DHCP4_ROUTERS:--}" "${CONNECTIVITY_STATE:--}"
    ip -4 route show default 2>/dev/null | sed 's/^/    /'
} >> "$log" 2>/dev/null
# keep the last 2000 lines
if [ "$(wc -l < "$log" 2>/dev/null || echo 0)" -gt 3000 ]; then
    tail -n 2000 "$log" > "$log.tmp" && mv -f "$log.tmp" "$log"
fi
exit 0
