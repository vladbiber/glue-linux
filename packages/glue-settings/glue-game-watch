#!/bin/sh
# glue-game-watch: per-session game helper, started by the session wrapper
# - every Steam game (reaper SteamLaunch, native or Proton) joins GameMode
#   while it runs, so glue-perf switches to performance and back
# - NVIDIA: Steam's shader pre-caching starts off (glue-steam-precache auto)
# - NVIDIA: user Flatpaks get the GL extension of the new host driver
uid=$(id -u)
run="${XDG_RUNTIME_DIR:-/run/user/$uid}"
lock="$run/glue-game-watch.lock"
exec 9>"$lock" || exit 0
flock -n 9 || exit 0
has() { command -v "$1" >/dev/null 2>&1; }

if [ -r /sys/module/nvidia/version ]; then
	has steam && glue-steam-precache auto >/dev/null 2>&1
	if has flatpak; then
		read -r ver < /sys/module/nvidia/version
		ver=$(echo "$ver" | tr . -)
		# only where an older NVIDIA GL extension shows Flatpak apps use it;
		# late, so the network is up
		(
			sleep 60
			list=$(flatpak --user list --runtime --columns=application,origin 2>/dev/null)
			for kind in GL GL32; do
				ext="org.freedesktop.Platform.$kind.nvidia-"
				echo "$list" | grep -q "^$ext$ver[[:space:]]" && continue
				origin=$(echo "$list" | awk -v k="$ext" 'index($1, k) == 1 { print $2; exit }')
				[ -n "$origin" ] || continue
				nice -n 10 flatpak --user install -y --noninteractive "$origin" "$ext$ver" \
					>/dev/null 2>&1
			done
		) &
	fi
fi

has steam && has gamemoded || { wait; exit 0; }

# Steam writes its pid here; while it is down a slow tick is enough
steam_up() {
	read -r sp 2>/dev/null < "$HOME/.steam/steam.pid" && kill -0 "$sp" 2>/dev/null
}
seen=" "
while [ -e "$lock" ]; do
	if ! steam_up; then
		seen=" "
		sleep 15
		continue
	fi
	now=" "
	for p in $(pgrep -u "$uid" -f '^[^ ]*/ubuntu12_32/reaper SteamLaunch AppId='); do
		now="$now$p "
		case "$seen" in *" $p "*) continue ;; esac
		# gamemoded drops the client when the reaper (the whole game) exits
		gamemoded --request="$p" >/dev/null 2>&1
	done
	seen=$now
	sleep 3
done
