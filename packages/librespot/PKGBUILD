# Maintainer: Glue Linux
# Spotify Connect client; spotc plays through it (pipe backend).
pkgname=librespot
pkgver=0.8.0
pkgrel=1
pkgdesc="Open source client library and player for Spotify"
arch=('x86_64')
url="https://github.com/librespot-org/librespot"
license=('MIT')
depends=('alsa-lib' 'gcc-libs' 'glibc')
makedepends=('rust' 'git')
source=("git+https://github.com/librespot-org/librespot.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    cargo build --frozen --release
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/librespot "$pkgdir/usr/bin/librespot"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
