# Maintainer: Glue Linux
# Calamares configuration for Glue Linux: sequence,
# generated selection pages, glueinstall/gluefstab job modules and branding.
pkgname=glue-calamares-config
pkgver=0.2.0
pkgrel=9
pkgdesc="Glue Linux installer configuration for Calamares (sequence, pages, Glue job modules, branding)"
arch=('any')
url="https://github.com/vladbiber/glue-linux"
license=('GPL-3.0-or-later')
depends=('calamares' 'kpmcore' 'ckbcomp' 'polkit' 'glue-installer' 'glue-branding' 'glue-welcome' 'os-prober')
backup=('etc/calamares/settings.conf')
source=()
sha256sums=()

package() {
    local cfg="$pkgdir/etc/calamares"
    install -Dm644 "$startdir/settings.conf" "$cfg/settings.conf"
    # Standard module configs + the generated notesqml instances (glue*.conf)
    local f
    for f in "$startdir"/modules/*.conf; do
        install -Dm644 "$f" "$cfg/modules/$(basename "$f")"
    done
    # Glue job modules (python): module.desc + main.py; Calamares reads their
    # config from modules/<name>.conf (installed by the loop above)
    local mod
    for mod in glueinstall gluefstab; do
        install -Dm644 "$startdir/modules/$mod/module.desc" "$cfg/modules/$mod/module.desc"
        install -Dm644 "$startdir/modules/$mod/main.py" "$cfg/modules/$mod/main.py"
    done
    # QML pages (notesqml@gluedesktop/gluenetwork load them from the branding
    # directory); DesktopData.js is generated from the catalog
    install -Dm644 "$startdir/modules/gluedesktop/gluedesktop.qml" "$cfg/branding/glue/gluedesktop.qml"
    install -Dm644 "$startdir/modules/gluedesktop/DesktopData.js" "$cfg/branding/glue/DesktopData.js"
    install -Dm644 "$startdir/modules/gluenetwork/gluenetwork.qml" "$cfg/branding/glue/gluenetwork.qml"
    for f in "$startdir"/modules/gluechoice/*; do
        install -Dm644 "$f" "$cfg/branding/glue/$(basename "$f")"
    done
    # Launcher (live-only): elevates Calamares with pkexec
    install -Dm755 "$startdir/glue-install-gui" "$pkgdir/usr/bin/glue-install-gui"
    install -Dm644 "$startdir/glue-install-gui.desktop" \
        "$pkgdir/usr/share/applications/glue-install-gui.desktop"
    install -Dm644 "$startdir/branding/glue/branding.desc" "$cfg/branding/glue/branding.desc"
    install -Dm644 "$startdir/branding/glue/show.qml" "$cfg/branding/glue/show.qml"
    # Logo and welcome image come from glue-welcome / glue-branding (no copies)
    ln -s /usr/share/icons/hicolor/scalable/apps/org.glue.Welcome.svg \
        "$cfg/branding/glue/logo.svg"
    ln -s /usr/share/backgrounds/glue/wallpaper.png "$cfg/branding/glue/welcome.png"
    # calamares -c /etc/calamares refuses to start without qml/ in that dir
    ln -s /usr/share/calamares/qml "$cfg/qml"
}
