# Maintainer: Glue Linux
# AUR-only upstream; Quickshell desktop shell made for Hyprland. Glue runs it on
# gluewc: glue/apply.sh swaps its Hyprland service for one fed by gluewc's
# workspace state file and gluewc-msg (ADR-026).
pkgname=caelestia-shell
pkgver=2.5.0
pkgrel=2
pkgdesc="The Caelestia desktop shell, made to run on gluewc"
arch=('x86_64')
url="https://github.com/caelestia-dots/shell"
license=('GPL-3.0-only')
depends=('caelestia-cli' 'quickshell' 'glibc' 'gcc-libs' 'ddcutil' 'brightnessctl' 'libcava'
         'networkmanager' 'lm_sensors' 'aubio' 'libpipewire' 'libqalculate' 'power-profiles-daemon'
         'ttf-material-symbols-variable' 'ttf-rubik-vf' 'ttf-cascadia-code-nerd'
         'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-m3shapes' 'swappy' 'fish' 'bash')
makedepends=('cmake' 'ninja' 'qt6-shadertools')
_pkg="$pkgname-v$pkgver"
source=("$url/releases/download/v$pkgver/$_pkg.tar.gz")
sha256sums=('6bef9feff9f9c6afeb6fdf0b9bb1cfc3cfd7dff4c2a020e8079d6720975f3b6a')

build() {
    cd "$_pkg"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION=$pkgver \
        -DGIT_REVISION="$(cat REVISION)" \
        -DDISTRIBUTOR="Glue Linux"
    cmake --build build
}

package() {
    cd "$_pkg"
    DESTDIR="$pkgdir" cmake --install build
    sh "$startdir/glue/apply.sh" "$pkgdir/etc/xdg/quickshell/caelestia"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
