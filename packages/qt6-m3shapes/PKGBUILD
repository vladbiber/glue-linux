# Maintainer: Glue Linux
# AUR-only upstream; Material 3 shapes QML module for caelestia.
pkgname=qt6-m3shapes
pkgver=r38.8a6fe89
pkgrel=1
_commit=8a6fe8961749887d677700b6508e0c9249968b7e
pkgdesc="A Qt6 library for Material 3 Expressive shapes"
arch=('x86_64')
url="https://github.com/soramanew/m3shapes"
license=('Apache-2.0')
depends=('qt6-base' 'qt6-declarative')
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools')
provides=('qt6-m3shapes-git')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
