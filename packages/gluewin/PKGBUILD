# Maintainer: Glue Linux
pkgname=gluewin
pkgver=r2.6d4fcbf
pkgrel=1
pkgdesc="Very light X11 window manager that looks and works like Windows 11, with a Windows-style Settings app"
arch=('x86_64')
url="https://github.com/vladbiber/gluewin"
license=('MIT')
depends=('libx11' 'libxft' 'libxrender' 'libxext' 'libxrandr' 'libpng' 'libjpeg-turbo' 'libwebp' 'xorg-xinit' 'xorg-setxkbmap' 'dbus'
         'xwallpaper' 'brightnessctl' 'wireplumber' 'networkmanager' 'alacritty')
optdepends=('bluez-utils: Bluetooth page and quick toggle'
            'pavucontrol: advanced sound settings'
            'arandr: multi-monitor layout'
            'zenity: wallpaper file picker'
            'flatpak: Flatpak updates and uninstall'
            'pipewire: audio' 'pipewire-pulse: PulseAudio-compatible audio')
makedepends=('git' 'pkgconf')
source=("git+https://github.com/vladbiber/gluewin.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$pkgname"
    make
}

package() {
    cd "$srcdir/$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
