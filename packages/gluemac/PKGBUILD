# Maintainer: Glue Linux
# gluemac: the macOS-style Glue session, a gluewc fork with floating windows,
# Spaces, Mission Control and a Mac title bar. Its own SceneFX (scenefx/, with
# Liquid Glass) is built by the Makefile and linked statically, so no scenefx0.5.
# GLUEMAC_SRC=file:///src/gluemac builds an unpushed checkout (GLUE_LOCAL=1)
pkgname=gluemac
pkgver=0.3.0.r63.9252cff
pkgrel=1
_commit=9252cffb4ea6347517a38ce2c430fede89d56dcc
pkgdesc="Wayland compositor that works like a Mac: floating windows, Spaces, Mission Control"
arch=('x86_64')
url="https://github.com/vladbiber/gluemac"
license=('GPL-3.0-only')
depends=('wlroots0.20' 'wayland' 'libinput' 'libxkbcommon' 'pixman'
         'libdrm' 'libxcb' 'xcb-util-wm' 'mesa' 'libglvnd' 'lcms2' 'dbus'
         'xorg-xwayland' 'pango' 'cairo' 'librsvg')
makedepends=('git' 'wayland-protocols' 'meson' 'ninja')
optdepends=('macshell: the menu bar, Dock, Spotlight and Control Center gluemac autostarts'
            'pipewire: audio in the session'
            'wireplumber: audio session manager and wpctl for the volume keys'
            'pipewire-pulse: PulseAudio compatible audio'
            'alacritty: terminal on Ctrl+Opt+Cmd+T'
            'brightnessctl: brightness keys through gluemac-backlight'
            'playerctl: media keys'
            'grim: screenshots'
            'slurp: screenshots of a region'
            'wl-clipboard: screenshots to the clipboard'
            'glib2: gsettings, hides the GTK title buttons gluemac draws itself')
source=("gluemac::git+${GLUEMAC_SRC:-https://github.com/vladbiber/gluemac.git}#commit=$_commit")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf '%s.r%s.%s' "$(sed -n 's/^_VERSION = //p' config.mk)" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$pkgname"
    [ -f scenefx/meson.build ] || {
        echo "ERROR: the vendored scenefx/ is missing" >&2; exit 1; }
    # the shell is started by gluemac itself, not by the session wrapper
    grep -q '^autostart = glue-macshell$' config.def.conf || {
        echo "ERROR: config.def.conf no longer autostarts MacShell" >&2; exit 1; }
}

build() {
    cd "$pkgname"
    make PREFIX=/usr
}

package() {
    cd "$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc/gluemac/docs/media"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
