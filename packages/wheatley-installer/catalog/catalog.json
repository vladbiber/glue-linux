{
  "version": 1,
  "kernels": [
    {
      "id": "linux-cachyos",
      "name": "CachyOS Kernel",
      "description": "Performance-optimized kernel with BORE scheduler and CachyOS patches. The default kernel for Wheatley Linux.",
      "packages": [
        "linux-cachyos",
        "linux-cachyos-headers"
      ],
      "primary": true
    },
    {
      "id": "linux-zen",
      "name": "Zen Kernel",
      "description": "Community-developed kernel tuned for desktop responsiveness. A solid secondary option.",
      "packages": [
        "linux-zen",
        "linux-zen-headers"
      ],
      "primary": false
    }
  ],
  "inits": [
    {
      "id": "dinit",
      "name": "dinit",
      "description": "Recommended init system for Wheatley Linux. Fast, simple, and dependency-tracking. Recommended for its clean design and quick boot times.",
      "packages": [
        "dinit"
      ],
      "recommended": true
    },
    {
      "id": "runit",
      "name": "runit",
      "description": "Minimalist init system with a proven track record. Familiar to Void Linux users.",
      "packages": [
        "runit"
      ],
      "recommended": false
    },
    {
      "id": "openrc",
      "name": "OpenRC",
      "description": "Battle-tested init system from Gentoo. Familiar, well documented, and widely supported on Artix.",
      "packages": [
        "openrc"
      ],
      "recommended": false
    }
  ],
  "sessions": [
    {
      "id": "apeturewm",
      "name": "ApertureWM",
      "kind": "wm",
      "description": "Aperture-themed custom window manager built for Wheatley Linux. Stacking WM with an amber aesthetic and minimal overhead.",
      "ease": 3,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal"
        },
        {
          "keys": "Super+d",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+h/j/k/l",
          "action": "Move focus left/down/up/right"
        },
        {
          "keys": "Super+Shift+h/j/k/l",
          "action": "Move window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+Space",
          "action": "Toggle floating mode"
        }
      ],
      "screenshot": "screenshots/apeturewm.png",
      "packages": [
        "apeturewm",
        "st-wheatley",
        "rofi"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "apeturewm"
    },
    {
      "id": "nvwm",
      "name": "nvwm",
      "kind": "wm",
      "description": "Light and strong custom window manager. Minimal footprint, maximum control. Part of the Wheatley Linux custom package set.",
      "ease": 3,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal"
        },
        {
          "keys": "Super+d",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+h/j/k/l",
          "action": "Focus window left/down/up/right"
        },
        {
          "keys": "Super+Shift+h/j/k/l",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        }
      ],
      "screenshot": "screenshots/nvwm.png",
      "packages": [
        "nvwm",
        "st-wheatley",
        "rofi"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "nvwm"
    },
    {
      "id": "atomwm",
      "name": "atomwm",
      "kind": "wm",
      "description": "The lightest window manager in the world: raw X11 protocol, zero malloc, ~150 KB of RAM. Monocle (one window at a time), blocking 0% CPU loop. For minimalists.",
      "ease": 2,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+q",
          "action": "Open terminal (st)"
        },
        {
          "keys": "Super+Space",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+c",
          "action": "Close focused window"
        },
        {
          "keys": "Super+Tab",
          "action": "Next window"
        },
        {
          "keys": "Super+w",
          "action": "Previous window"
        },
        {
          "keys": "Super+Shift+q",
          "action": "Quit atomwm"
        }
      ],
      "screenshot": "screenshots/atomwm.png",
      "packages": [
        "atomwm",
        "st-wheatley",
        "rofi"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "atomwm"
    },
    {
      "id": "niri",
      "name": "Niri",
      "kind": "wm",
      "description": "User-friendly scrollable-tiling Wayland compositor. Windows tile into a horizontal strip you can scroll through. Pair it with a shell/bar of your choice.",
      "ease": 4,
      "lightness": 4,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal"
        },
        {
          "keys": "Super+d",
          "action": "Open application launcher (fuzzel)"
        },
        {
          "keys": "Super+q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Focus column left/right"
        },
        {
          "keys": "Super+Shift+Left/Right",
          "action": "Move column left/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+Shift+f",
          "action": "Toggle floating window"
        },
        {
          "keys": "Super+1-9",
          "action": "Focus workspace 1-9"
        }
      ],
      "screenshot": "screenshots/niri.png",
      "packages": [
        "niri",
        "foot",
        "fuzzel",
        "alacritty",
        "rofi",
        "xwayland-satellite"
      ],
      "services": [],
      "shell_choices": [
        "noctalia"
      ],
      "session_type": "wayland",
      "exec": "niri"
    },
    {
      "id": "sway",
      "name": "Sway",
      "kind": "wm",
      "description": "Minimal i3-compatible tiling Wayland compositor. No frills, pure keyboard-driven tiling. Great for those who know what they want.",
      "ease": 3,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal"
        },
        {
          "keys": "Super+d",
          "action": "Open application launcher (dmenu/wofi)"
        },
        {
          "keys": "Super+Shift+q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+h/j/k/l",
          "action": "Focus left/down/up/right"
        },
        {
          "keys": "Super+Shift+h/j/k/l",
          "action": "Move window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+Shift+Space",
          "action": "Toggle floating"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+1-9",
          "action": "Move container to workspace 1-9"
        },
        {
          "keys": "Super+Shift+e",
          "action": "Exit sway"
        }
      ],
      "screenshot": "screenshots/sway.png",
      "packages": [
        "sway",
        "foot",
        "dmenu",
        "alacritty",
        "rofi",
        "xwayland-satellite"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "wayland",
      "exec": "sway"
    },
    {
      "id": "kde-plasma",
      "name": "KDE Plasma",
      "kind": "de",
      "description": "Optional full desktop environment. Feature-rich and highly customizable. Included for those who prefer a traditional DE experience — note this is not the Wheatley way.",
      "ease": 5,
      "lightness": 2,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal (Konsole)"
        },
        {
          "keys": "Super",
          "action": "Open application launcher"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Snap window left/right"
        },
        {
          "keys": "Super+Up",
          "action": "Maximize window"
        },
        {
          "keys": "Super+Down",
          "action": "Minimize window"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        }
      ],
      "screenshot": "screenshots/kde-plasma.png",
      "packages": [
        "plasma-meta",
        "dolphin",
        "konsole",
        "tesseract-data-eng"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "startplasma-x11"
    },
    {
      "id": "gnome",
      "name": "GNOME (minimal)",
      "kind": "de",
      "description": "Optional minimal GNOME desktop: the Shell, a terminal, the Files app and Settings — no extra GNOME apps. Runs on Wayland, coexists cleanly with KDE Plasma if you install both.",
      "ease": 5,
      "lightness": 2,
      "keybindings": [
        {
          "keys": "Super",
          "action": "Activities overview (launcher + windows)"
        },
        {
          "keys": "Super+A",
          "action": "Show all applications"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Super+Up",
          "action": "Maximize window"
        },
        {
          "keys": "Super+PageUp/PageDown",
          "action": "Switch workspace"
        }
      ],
      "screenshot": "screenshots/gnome.png",
      "packages": [
        "gnome-shell",
        "gnome-session",
        "gnome-session-sysvinit",
        "gnome-console",
        "nautilus",
        "gnome-control-center",
        "gnome-backgrounds",
        "xdg-user-dirs"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "wayland",
      "exec": "gnome-session",
      "desktop": "GNOME"
    },
    {
      "id": "xfce",
      "name": "XFCE",
      "kind": "de",
      "description": "Optional full desktop environment. Lightweight and traditional. Included as a friendly fallback DE — considered optional extra on top of the core Wheatley experience.",
      "ease": 5,
      "lightness": 3,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal (xfce4-terminal)"
        },
        {
          "keys": "Alt+F2",
          "action": "Open run dialog"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Super+d",
          "action": "Show desktop"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Print",
          "action": "Take screenshot"
        }
      ],
      "screenshot": "screenshots/xfce.png",
      "packages": [
        "xfce4",
        "xfce4-goodies"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "startxfce4"
    }
  ],
  "shells": [
    {
      "id": "noctalia",
      "name": "Noctalia Shell",
      "description": "Polished shell/bar for Wayland compositors like Niri. Clean amber-tinted aesthetic.",
      "ease": 4,
      "lightness": 4,
      "keybindings": [
        {
          "keys": "Super+b",
          "action": "Toggle bar visibility"
        },
        {
          "keys": "Super+n",
          "action": "Open notification center"
        },
        {
          "keys": "Super+m",
          "action": "Open media controls"
        },
        {
          "keys": "Super+s",
          "action": "Open system settings panel"
        },
        {
          "keys": "Super+Shift+b",
          "action": "Reload bar configuration"
        }
      ],
      "screenshot": "screenshots/noctalia.png",
      "packages": [
        "noctalia-shell"
      ],
      "exec": "qs -c noctalia-shell"
    }
  ],
  "support": [
    {
      "id": "bluetooth",
      "name": "Bluetooth Support",
      "description": "Installs Bluetooth stack (BlueZ) and a GUI manager (Blueman) for easy pairing and management.",
      "packages": [
        "bluez",
        "bluez-utils",
        "blueman"
      ],
      "services": [
        "bluetoothd"
      ],
      "default": false
    }
  ],
  "gaming": {
    "name": "Gaming Mode",
    "description": "Fully prepares the system for plug-and-play gaming. Installs Steam (with Proton GE preinstalled), Heroic Games Launcher, Firefox, Vulkan support, GameMode, MangoHud, Gamescope, and fan/sensor tools (lm_sensors). GPU drivers are auto-detected and installed.",
    "packages": [
      "steam",
      "heroic-games-launcher-bin",
      "proton-ge-custom-bin",
      "firefox",
      "vulkan-icd-loader",
      "lib32-vulkan-icd-loader",
      "lib32-mesa",
      "lib32-pipewire",
      "gamemode",
      "lib32-gamemode",
      "mangohud",
      "gamescope",
      "lm_sensors"
    ],
    "services": [],
    "gpu_autodetect": true
  },
  "minimal": {
    "name": "Minimal Install",
    "description": "Bare system with no window manager or desktop environment preselected. You get a bootable base with the essentials — shell, network tools, and package manager — and build from there yourself."
  }
}
