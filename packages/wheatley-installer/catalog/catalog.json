    {
     "keys": "Super+n",
     "action": "Open notification popup"
    },
    {
     "keys": "Super+Shift+n",
     "action": "Clear all notifications"
    },
    {
     "keys": "Super+m",
     "action": "Toggle music widget"
    },
    {
     "keys": "Super+Shift+s",
     "action": "Open screenshot/screen tools"
    }
   ],
   "screenshot": "screenshots/imperative-dots.png",
   "packages": [
    "quickshell",
    "imperative-dots"
   ]
  }
 ],
 "support": [
  {
   "id": "bluetooth",
   "name": "Bluetooth Support",
   "description": "Installs Bluetooth stack (BlueZ) and a GUI manager (Blueman) for easy pairing and management.",
   "packages": [
    "bluez",
    "bluez-utils",
    "blueman"
   ],
   "services": [
    "bluetoothd"
   ],
   "default": false
  }
 ],
 "gaming": {
  "name": "Gaming Mode",
  "description": "Fully prepares the system for plug-and-play gaming. Installs Steam, Heroic Games Launcher, Proton-GE, Vulkan support, GameMode, MangoHud, and more. GPU drivers are auto-detected and installed.",
  "packages": [
   "steam",
   "heroic-games-launcher-bin",
   "proton-ge-custom-bin",
   "vulkan-icd-loader",
   "lib32-vulkan-icd-loader",
   "gamemode",
   "lib32-gamemode",
   "mangohud",
   "lib32-mangohud"
  ],
  "services": [],
  "gpu_autodetect": true
 },
 "minimal": {
  "name": "Minimal Install",
  "description": "Bare system with no window manager or desktop environment preselected. You get a bootable base with the essentials — shell, network tools, and package manager — and build from there yourself."
 }
}