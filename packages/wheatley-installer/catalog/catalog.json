  {
   "id": "mangowc",
   "name": "MangoWC",
   "kind": "wm",
   "description": "User-friendly Wayland compositor. A smooth, modern tiling experience. Pair it with a shell/bar of your choice.",
   "ease": 4,
   "lightness": 4,
   "keybindings": [
    {
     "keys": "Super+Return",
     "action": "Open terminal"
    },
    {
     "keys": "Super+d",
     "action": "Open application launcher"
    },
    {
     "keys": "Super+q",
     "action": "Close focused window"
    },
    {
     "keys": "Super+h/j/k/l",
     "action": "Move focus left/down/up/right"
    },
    {
     "keys": "Super+Shift+h/j/k/l",
     "action": "Move window left/down/up/right"
    },
    {
     "keys": "Super+f",
     "action": "Toggle fullscreen"
    },
    {
     "keys": "Super+1-9",
     "action": "Switch to workspace 1-9"
    },
    {
     "keys": "Super+Shift+1-9",
     "action": "Move window to workspace 1-9"
    }
   ],
   "screenshot": "screenshots/mangowc.png",
