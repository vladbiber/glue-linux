    "imperative-dots"
   ]
  },
  {
   "id": "niri",
   "name": "Niri",
   "kind": "wm",
   "description": "User-friendly scrollable-tiling Wayland compositor. Windows tile into a horizontal strip you can scroll through. Pair it with a shell/bar of your choice.",
   "ease": 4,
   "lightness": 4,
   "keybindings": [
    {
     "keys": "Super+Return",
     "action": "Open terminal"
    },
    {
     "keys": "Super+d",
     "action": "Open application launcher (fuzzel)"
    },
    {
     "keys": "Super+q",
     "action": "Close focused window"
    },
    {
     "keys": "Super+Left/Right",
     "action": "Focus column left/right"
    },
    {
     "keys": "Super+Shift+Left/Right",
     "action": "Move column left/right"
    },
    {
     "keys": "Super+f",
     "action": "Toggle fullscreen"
    },
    {
     "keys": "Super+Shift+f",
     "action": "Toggle floating window"
    },
    {
     "keys": "Super+1-9",
     "action": "Focus workspace 1-9"
    }
   ],
   "screenshot": "screenshots/niri.png",
   "packages": [
    "niri"
   ],
   "services": [],
   "shell_choices": [
    "noctalia",
    "imperative-dots"
   ]
  },
  {
   "id": "sway",
   "name": "Sway",
   "kind": "wm",
   "description": "Minimal i3-compatible tiling Wayland compositor. No frills, pure keyboard-driven tiling. Great for those who know what they want.",
   "ease": 3,
   "lightness": 5,
   "keybindings": [
    {
     "keys": "Super+Return",
     "action": "Open terminal"
    },
    {
     "keys": "Super+d",
     "action": "Open application launcher (dmenu/wofi)"
    },
    {
     "keys": "Super+Shift+q",
     "action": "Close focused window"
    },
    {
     "keys": "Super+h/j/k/l",
     "action": "Focus left/down/up/right"
    },
    {
     "keys": "Super+Shift+h/j/k/l",
     "action": "Move window left/down/up/right"
    },
    {
     "keys": "Super+f",
     "action": "Toggle fullscreen"
    },
    {
     "keys": "Super+Shift+Space",
     "action": "Toggle floating"
    },
    {
     "keys": "Super+1-9",
     "action": "Switch to workspace 1-9"
    },
    {
     "keys": "Super+Shift+1-9",
     "action": "Move container to workspace 1-9"
    },
    {
     "keys": "Super+Shift+e",
     "action": "Exit sway"
    }
   ],
   "screenshot": "screenshots/sway.png",
   "packages": [
    "sway"
   ],
   "services": [],
   "shell_choices": []
  },
  {
   "id": "kde-plasma",
   "name": "KDE Plasma",
   "kind": "de",
   "description": "Optional full desktop environment. Feature-rich and highly customizable. Included for those who prefer a traditional DE experience — note this is not the Wheatley way.",
   "ease": 5,
   "lightness": 2,
   "keybindings": [
    {
     "keys": "Ctrl+Alt+T",
     "action": "Open terminal (Konsole)"
    },
    {
     "keys": "Super",
     "action": "Open application launcher"
    },
    {
     "keys": "Alt+F4",
     "action": "Close window"
    },
    {
     "keys": "Super+Left/Right",
     "action": "Snap window left/right"
    },
    {
     "keys": "Super+Up",
     "action": "Maximize window"
    },
    {
     "keys": "Super+Down",
     "action": "Minimize window"
    },
    {
     "keys": "Alt+Tab",
     "action": "Switch windows"
    }
   ],
   "screenshot": "screenshots/kde-plasma.png",
   "packages": [
    "plasma-meta",
    "dolphin",
    "konsole"
   ],
   "services": [],
   "shell_choices": []
  },
  {
   "id": "xfce",
   "name": "XFCE",
   "kind": "de",
   "description": "Optional full desktop environment. Lightweight and traditional. Included as a friendly fallback DE — considered optional extra on top of the core Wheatley experience.",
   "ease": 5,
   "lightness": 3,
   "keybindings": [
    {
     "keys": "Ctrl+Alt+T",
     "action": "Open terminal (xfce4-terminal)"
    },
    {
     "keys": "Alt+F2",
     "action": "Open run dialog"
    },
    {
     "keys": "Alt+F4",
     "action": "Close window"
    },
    {
     "keys": "Super+d",
     "action": "Show desktop"
    },
    {
     "keys": "Alt+Tab",
     "action": "Switch windows"
    },
    {
     "keys": "Super+Left/Right",
     "action": "Tile window left/right"
    },
    {
     "keys": "Print",
     "action": "Take screenshot"
    }
   ],
   "screenshot": "screenshots/xfce.png",
   "packages": [
    "xfce4",
    "xfce4-goodies"
   ],
   "services": [],
   "shell_choices": []
  }
 ],
 "shells": [
  {
   "id": "noctalia",
   "name": "Noctalia Shell",
   "description": "Polished shell/bar designed for Wayland compositors like MangoWC and Niri. Clean amber-tinted aesthetic.",
   "ease": 4,
   "lightness": 4,
   "keybindings": [
    {
     "keys": "Super+b",
     "action": "Toggle bar visibility"
    },
    {
     "keys": "Super+n",
     "action": "Open notification center"
    },
    {
     "keys": "Super+m",
     "action": "Open media controls"
    },
    {
     "keys": "Super+s",
     "action": "Open system settings panel"
    },
    {
     "keys": "Super+Shift+b",
     "action": "Reload bar configuration"
    }
   ],
   "screenshot": "screenshots/noctalia.png",
   "packages": [
    "noctalia-shell"
   ]
  },
  {
   "id": "imperative-dots",
   "name": "ilyamiro Quickshell (imperative-dots)",
   "description": "Portable Quickshell config v2.0.0 from github.com/ilyamiro/imperative-dots — supports Niri, MangoWM and other Wayland compositors. Feature-rich bar with widgets, blur, and animations.",
