# Maintainer: Wheatley Linux
pkgname=wheatley-installer
pkgver=1
pkgrel=8
pkgdesc="Wheatley Linux TUI installer (Python curses, catalog-driven)"
arch=('any')
url="https://github.com/Vifuddyxg"
license=('MIT')
depends=('python' 'artools-base' 'gptfdisk' 'dosfstools' 'e2fsprogs'
         'grub' 'efibootmgr' 'util-linux')
# wheatley-install launcher and pacman.conf are staged next to this PKGBUILD
# by scripts/make-iso.sh — makepkg won't resolve ../../ relative source paths.
source=('wheatley-install'
        'pacman.conf')
sha256sums=('SKIP' 'SKIP')

package() {
    # Launcher
    install -Dm755 "$srcdir/wheatley-install" "$pkgdir/usr/bin/wheatley-install"

    # pacman.conf (repos: artix + cachyos + wheatley) for pacstrap -C
    install -Dm644 "$srcdir/pacman.conf" "$pkgdir/usr/share/wheatley/pacman.conf"

    # Python module (all .py files from the package dir, no tests or __pycache__)
    local moddir="$pkgdir/usr/lib/wheatley-installer/wheatley_installer"
    install -dm755 "$moddir"
    find "$startdir/wheatley_installer" -maxdepth 1 -name '*.py' | while read -r f; do
        install -Dm644 "$f" "$moddir/$(basename "$f")"
    done

    # Catalog JSON
    install -Dm644 "$startdir/catalog/catalog.json" \
        "$pkgdir/usr/share/wheatley-installer/catalog/catalog.json"

    # Screenshots (may be empty directory — tolerate gracefully)
    if [ -d "$startdir/catalog/screenshots" ]; then
        find "$startdir/catalog/screenshots" -type f | while read -r f; do
            rel="${f#$startdir/catalog/screenshots/}"
            install -Dm644 "$f" \
                "$pkgdir/usr/share/wheatley-installer/catalog/screenshots/$rel"
        done
    fi
}
