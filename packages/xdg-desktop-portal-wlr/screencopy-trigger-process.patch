From 55f5d3859b441d2f82806c0abc5de846642891e4 Mon Sep 17 00:00:00 2001
From: Ismael Luceno <iluceno@suse.de>
Date: Tue, 11 Aug 2026 19:12:36 +0200
Subject: [PATCH 2/2] screencast: Trigger the graph from the wlr-screencopy
 backend

The stream is connected with PW_STREAM_FLAG_DRIVER, so .process only
runs in reply to pw_stream_trigger_process(). Only ext_image_copy calls
it; wlr-screencopy never does, so capture delivers the frame primed at
PW_STREAM_STATE_STREAMING and then stalls forever. The retry timer does
not help: it is armed only when a dequeue fails.

Affects compositors that expose zwlr_screencopy_manager_v1 but not
ext-image-copy-capture-v1, i.e. wlroots <= 0.18.

Fixes: c613a8bc7 ("screencast: drive the Pipewire graph by ourselves")
---
 src/screencast/wlr_screencopy.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/screencast/wlr_screencopy.c b/src/screencast/wlr_screencopy.c
index 4cb5d24..693ca4c 100644
--- a/src/screencast/wlr_screencopy.c
+++ b/src/screencast/wlr_screencopy.c
@@ -33,10 +33,11 @@ static void wlr_frame_finish(struct xdpw_screencast_instance *cast) {
 }
 
 // Ends the current capture cycle: hand the buffer back to PipeWire and drop
-// the wlr frame.
+// the wlr frame. We drive the graph, so ask for the next cycle ourselves.
 static void wlr_frame_done(struct xdpw_screencast_instance *cast) {
 	xdpw_pwr_enqueue_buffer(cast);
 	wlr_frame_finish(cast);
+	pw_stream_trigger_process(cast->stream);
 }
 
 static void wlr_frame_buffer_done(void *data,
-- 
2.52.0

