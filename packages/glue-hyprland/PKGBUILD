# Maintainer: Glue Linux
# The Hyprland session of Glue: the launcher of the ii desktop. Caelestia runs
# on gluewc since ADR-026, so its Hyprland config is gone.
pkgname=glue-hyprland
pkgver=1
pkgrel=2
pkgdesc="Glue Linux Hyprland session (ii)"
arch=('any')
url="https://github.com/vladbiber/glue-linux"
license=('GPL-3.0-only')
depends=('hyprland' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk' 'adwaita-cursors'
         'hyprpicker' 'wl-clipboard' 'cliphist' 'gnome-keyring')
optdepends=('ii-vynx: the ii desktop')
source=("glue-hyprland")
sha256sums=('SKIP')

package() {
    install -Dm755 glue-hyprland "$pkgdir/usr/bin/glue-hyprland"
}
