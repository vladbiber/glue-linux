#!/bin/sh
# glue-hyprland ii - start Hyprland with the ii desktop shell
case "${1:-}" in
    ii)
        ii-vynx-seed || echo "glue-hyprland: ii-vynx-seed failed" >&2
        conf=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua ;;
    *)
        echo "usage: glue-hyprland ii" >&2
        exit 2 ;;
esac
exec start-hyprland -- -c "$conf"
