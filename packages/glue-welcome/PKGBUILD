# Maintainer: Glue Linux
pkgname=glue-welcome
pkgver=0.3.0
pkgrel=1
pkgdesc="Glue Linux welcome window: keyboard shortcuts, system information and settings"
arch=('any')
url="https://github.com/vladbiber/glue-linux"
license=('GPL-3.0-only')
depends=('glue-apps' 'python')
conflicts=('glue-hub')
optdepends=('lm_sensors: temperature on the System page'
            'power-profiles-daemon: power mode switch')
source=('glue-welcome')
sha256sums=('SKIP')

package() {
    install -Dm755 "$srcdir/glue-welcome" "$pkgdir/usr/bin/glue-welcome"
    install -dm755 "$pkgdir/usr/lib/glue-welcome/glue_welcome"
    install -m644 "$startdir"/glue_welcome/*.py "$pkgdir/usr/lib/glue-welcome/glue_welcome/"
    install -Dm644 "$startdir/data/applications/org.glue.Welcome.desktop" \
        "$pkgdir/usr/share/applications/org.glue.Welcome.desktop"
    install -Dm644 "$startdir/data/autostart/org.glue.Welcome.desktop" \
        "$pkgdir/etc/xdg/autostart/org.glue.Welcome.desktop"
    install -Dm644 "$startdir/data/icons/org.glue.Welcome.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.glue.Welcome.svg"
    install -Dm644 "$startdir/../glue-installer/catalog/catalog.json" \
        "$pkgdir/usr/share/glue/catalog.json"
}
