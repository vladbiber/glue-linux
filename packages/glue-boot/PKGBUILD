# Maintainer: Glue Linux
pkgname=glue-boot
pkgver=1
pkgrel=2
pkgdesc="Glue Linux boot menu maintenance: regenerates /boot/limine.conf from /etc/glue/boot.conf and redeploys Limine on kernel and bootloader updates"
arch=('any')
url="https://github.com/vladbiber/glue-linux"
license=('GPL-3.0-or-later')
# util-linux: findmnt, lsblk; coreutils: cp, mv, sort, ls
depends=('limine' 'util-linux' 'coreutils')
optdepends=('efibootmgr: register Glue Linux in the UEFI boot menu')
source=('glue-boot-update'
        '95-glue-boot-update.hook'
        '95-glue-boot-deploy.hook')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    # drop-in Limine entries for other operating systems (installer, 3.4)
    install -d "$pkgdir/etc/glue/boot.d"
    install -Dm755 "$srcdir/glue-boot-update" "$pkgdir/usr/bin/glue-boot-update"
    # 95-: after mkinitcpio's 90-mkinitcpio-install, so the new initramfs exists
    install -Dm644 "$srcdir/95-glue-boot-update.hook" \
        "$pkgdir/usr/share/libalpm/hooks/95-glue-boot-update.hook"
    install -Dm644 "$srcdir/95-glue-boot-deploy.hook" \
        "$pkgdir/usr/share/libalpm/hooks/95-glue-boot-deploy.hook"
}
