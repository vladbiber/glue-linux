{
  "version": 1,
  "kernels": [
    {
      "id": "linux-cachyos",
      "name": "CachyOS Kernel",
      "description": "Performance-optimized kernel with BORE scheduler and CachyOS patches. The default kernel for Glue Linux.",
      "packages": [
        "linux-cachyos",
        "linux-cachyos-headers"
      ],
      "primary": true
    },
    {
      "id": "linux-zen",
      "name": "Zen Kernel",
      "description": "Community-developed kernel tuned for desktop responsiveness. A solid secondary option.",
      "packages": [
        "linux-zen",
        "linux-zen-headers"
      ],
      "primary": false
    }
  ],
  "inits": [
    {
      "id": "dinit",
      "name": "dinit",
      "description": "Recommended init system for Glue Linux. Fast, simple, and dependency-tracking. Recommended for its clean design and quick boot times.",
      "packages": [
        "dinit"
      ],
      "recommended": true
    },
    {
      "id": "runit",
      "name": "runit",
      "description": "Minimalist init system with a proven track record. Familiar to Void Linux users.",
      "packages": [
        "runit"
      ],
      "recommended": false
    },
    {
      "id": "openrc",
      "name": "OpenRC",
      "description": "Battle-tested init system from Gentoo. Familiar, well documented, and widely supported on Artix.",
      "packages": [
        "openrc"
      ],
      "recommended": false
    }
  ],
  "sessions": [
    {
      "id": "gluewc",
      "name": "gluewc",
      "kind": "wm",
      "description": "Glue's own Wayland compositor: friendly tiling with smooth animations and three layouts (bsp, scroll, drift) you can cycle with one key. The default Glue Linux session.",
      "ease": 4,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal (alacritty)"
        },
        {
          "keys": "Super+Space",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+c",
          "action": "Close focused window"
        },
        {
          "keys": "Super",
          "action": "Open the overview (tap Super alone)"
        },
        {
          "keys": "Super+←↑↓→",
          "action": "Move focus left/down/up/right"
        },
        {
          "keys": "Super+Shift+←↑↓→",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+v",
          "action": "Toggle floating (centered)"
        },
        {
          "keys": "Super+n",
          "action": "Cycle layout (bsp / scroll / drift)"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+s",
          "action": "Screenshot a region to the clipboard"
        },
        {
          "keys": "Super+Shift+F1",
          "action": "Show Welcome and shortcuts"
        }
      ],
      "screenshots": ["screenshots/gluewc-glueqs.png"],
      "packages": [
        "gluewc",
        "polkit-gnome",
        "nautilus"
      ],
      "services": [],
      "shell_choices": [
        "glueqs",
        "noctalia"
      ],
      "session_type": "wayland",
      "exec": "gluewc-session"
    },
    {
      "id": "nvwm",
      "name": "nvwm",
      "kind": "wm",
      "description": "Light and strong custom window manager. Minimal footprint, maximum control. Part of the Glue Linux custom package set.",
      "ease": 3,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal"
        },
        {
          "keys": "Super+d",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+←↑↓→",
          "action": "Focus window left/down/up/right"
        },
        {
          "keys": "Super+Shift+←↑↓→",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+F1",
          "action": "Show Welcome and shortcuts"
        }
      ],
      "screenshots": ["screenshots/nvwm.png"],
      "packages": [
        "nvwm",
        "st-glue",
        "rofi",
        "feh",
        "polkit-gnome",
        "nautilus"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "nvwm"
    },
    {
      "id": "kde-plasma",
      "name": "KDE Plasma",
      "kind": "de",
      "description": "Recommended for beginners: a classic desktop, works like Windows. Pick it as well if you are not sure tiling is for you.",
      "ease": 5,
      "lightness": 2,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal (Konsole)"
        },
        {
          "keys": "Super",
          "action": "Open application launcher"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Snap window left/right"
        },
        {
          "keys": "Super+Up",
          "action": "Maximize window"
        },
        {
          "keys": "Super+Down",
          "action": "Minimize window"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        }
      ],
      "screenshots": ["screenshots/kde-plasma.png"],
      "packages": [
        "plasma-meta",
        "dolphin",
        "konsole",
        "tesseract-data-eng"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "startplasma-x11"
    },
    {
      "id": "xfce",
      "name": "XFCE",
      "kind": "de",
      "description": "Optional full desktop environment. Lightweight and traditional. Included as a friendly fallback DE — considered optional extra on top of the core Glue experience.",
      "ease": 5,
      "lightness": 3,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal (xfce4-terminal)"
        },
        {
          "keys": "Alt+F2",
          "action": "Open run dialog"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Super+d",
          "action": "Show desktop"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Print",
          "action": "Take screenshot"
        }
      ],
      "screenshots": ["screenshots/xfce.png"],
      "packages": [
        "xfce4-session",
        "xfce4-panel",
        "xfwm4",
        "xfdesktop",
        "xfce4-settings",
        "thunar",
        "xfce4-terminal",
        "xfce4-power-manager"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "startxfce4"
    },
    {
      "id": "gnome",
      "name": "GNOME (minimal)",
      "kind": "de",
      "description": "Optional minimal GNOME desktop: the Shell, a terminal, the Files app and Settings — no extra GNOME apps. Runs on Wayland, coexists cleanly with KDE Plasma if you install both.",
      "ease": 5,
      "lightness": 2,
      "keybindings": [
        {
          "keys": "Super",
          "action": "Activities overview (launcher + windows)"
        },
        {
          "keys": "Super+A",
          "action": "Show all applications"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Super+Up",
          "action": "Maximize window"
        },
        {
          "keys": "Super+PageUp/PageDown",
          "action": "Switch workspace"
        }
      ],
      "screenshots": ["screenshots/gnome.png"],
      "packages": [
        "gnome-shell",
        "gnome-session",
        "gnome-session-sysvinit",
        "gnome-console",
        "nautilus",
        "gnome-control-center",
        "gnome-backgrounds",
        "xdg-user-dirs"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "wayland",
      "exec": "gnome-session",
      "desktop": "GNOME"
    },
    {
      "id": "cinnamon",
      "name": "Cinnamon",
      "kind": "de",
      "description": "A classic desktop, like in Linux Mint. Familiar menu, panel and system tray.",
      "ease": 5,
      "lightness": 3,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal"
        },
        {
          "keys": "Super",
          "action": "Open the menu"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Super+D",
          "action": "Show desktop"
        }
      ],
      "screenshots": ["screenshots/cinnamon.png"],
      "packages": [
        "cinnamon",
        "cinnamon-translations",
        "cinnamon-session",
        "nemo",
        "gnome-terminal",
        "xdg-user-dirs"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "cinnamon-session"
    }
  ],
  "shells": [
    {
      "id": "glueqs",
      "name": "glueqs",
      "description": "Glue's own desktop shell: bar, launcher, notifications and a settings panel, matched to gluewc. Recommended.",
      "ease": 5,
      "lightness": 4,
      "keybindings": [],
      "screenshots": ["screenshots/gluewc-glueqs.png"],
      "packages": [
        "glueqs"
      ],
      "exec": "glueqs"
    },
    {
      "id": "noctalia",
      "name": "Noctalia Shell",
      "description": "Polished shell/bar for Wayland compositors. Clean amber-tinted aesthetic.",
      "ease": 4,
      "lightness": 4,
      "keybindings": [
        {
          "keys": "Super+b",
          "action": "Toggle bar visibility"
        },
        {
          "keys": "Super+n",
          "action": "Open notification center"
        },
        {
          "keys": "Super+m",
          "action": "Open media controls"
        },
        {
          "keys": "Super+s",
          "action": "Open system settings panel"
        },
        {
          "keys": "Super+Shift+b",
          "action": "Reload bar configuration"
        }
      ],
      "screenshots": ["screenshots/gluewc-noctalia.png"],
      "packages": [
        "noctalia-shell",
        "noctalia-qs"
      ],
      "exec": "qs -c noctalia-shell"
    }
  ],
  "support": [
    {
      "id": "app-store",
      "name": "App store (Pacman + Flathub + AUR)",
      "description": "Glue Apps finds, installs and updates apps from the system repositories, Flathub and the AUR through yay. Recommended.",
      "packages": [
        "flatpak",
        "yay",
        "artixlinux-appstream-data",
        "pacman-contrib"
      ],
      "services": [],
      "default": true
    },
    {
      "id": "bluetooth",
      "name": "Bluetooth Support",
      "description": "Installs Bluetooth stack (BlueZ) and a GUI manager (Blueman) for easy pairing and management.",
      "packages": [
        "bluez",
        "bluez-utils",
        "blueman"
      ],
      "services": [
        "bluetoothd"
      ],
      "default": false
    }
  ],
  "gaming": {
    "name": "Gaming Mode",
    "description": "Fully prepares the system for plug-and-play gaming: Steam with Proton (CachyOS build preselected, Proton GE too), Heroic, Lutris, Faugus, Wine with winetricks/protontricks, Vulkan 32/64-bit, GameMode, MangoHud (32/64-bit) with GOverlay, Gamescope, a sched_ext CPU scheduler and ananicy-cpp process priorities. GPU drivers are auto-detected and installed.",
    "packages": [
      "steam",
      "heroic-games-launcher-bin",
      "proton-ge-custom-bin",
      "proton-cachyos-slr",
      "umu-launcher",
      "ntsync-autoload",
      "firefox",
      "vulkan-icd-loader",
      "lib32-vulkan-icd-loader",
      "lib32-mesa",
      "lib32-pipewire",
      "gamemode",
      "lib32-gamemode",
      "mangohud",
      "gamescope",
      "lm_sensors",
      "ananicy-cpp",
      "cachyos-ananicy-rules",
      "lib32-mangohud",
      "faugus-launcher",
      "wine-cachyos-opt",
      "lutris",
      "goverlay",
      "protontricks",
      "winetricks",
      "vulkan-tools",
      "ttf-liberation",
      "wqy-zenhei",
      "openal",
      "giflib",
      "glfw",
      "mpg123",
      "gst-plugins-base-libs",
      "libxslt",
      "lib32-alsa-plugins",
      "lib32-gtk3",
      "lib32-libva",
      "lib32-ocl-icd",
      "lib32-libjpeg-turbo"
    ],
    "services": [
      "ananicy-cpp"
    ],
    "gpu_autodetect": true,
    "schedulers": [
      {
        "id": "scx_lavd",
        "name": "scx_lavd",
        "description": "Latency-aware sched_ext scheduler tuned for gaming; runs with --performance. The CachyOS default.",
        "default": true
      },
      {
        "id": "scx_bpfland",
        "name": "scx_bpfland",
        "description": "sched_ext scheduler that prioritizes interactive tasks — UI and audio stay smooth under load.",
        "default": false
      },
      {
        "id": "none",
        "name": "None",
        "description": "No userspace scheduler: keep the kernel's built-in EEVDF scheduler.",
        "default": false
      }
    ]
  },
  "minimal": {
    "name": "Minimal Install",
    "description": "Bare system with no window manager or desktop environment preselected. You get a bootable base with the essentials — shell, network tools, and package manager — and build from there yourself."
  }
}
