{
  "version": 1,
  "kernels": [
    {
      "id": "linux-cachyos",
      "name": "CachyOS Kernel",
      "description": "The kernel tuned for speed, with the BORE scheduler and the CachyOS patches. The default for Glue Linux.",
      "packages": [
        "linux-cachyos",
        "linux-cachyos-headers"
      ],
      "primary": true
    },
    {
      "id": "linux-zen",
      "name": "Zen Kernel",
      "description": "A community kernel tuned for a responsive desktop. A good second choice.",
      "packages": [
        "linux-zen",
        "linux-zen-headers"
      ],
      "primary": false
    }
  ],
  "inits": [
    {
      "id": "dinit",
      "name": "dinit",
      "description": "Fast and simple, with quick boot times. The default for Glue Linux.",
      "packages": [
        "dinit"
      ],
      "recommended": true
    },
    {
      "id": "runit",
      "name": "runit",
      "description": "Small and proven over many years. Void Linux uses it.",
      "packages": [
        "runit"
      ],
      "recommended": false
    },
    {
      "id": "openrc",
      "name": "OpenRC",
      "description": "Mature and well documented. Gentoo uses it.",
      "packages": [
        "openrc"
      ],
      "recommended": false
    }
  ],
  "sessions": [
    {
      "id": "gluewc",
      "name": "gluewc + glueqs",
      "kind": "wm",
      "description": "Glue's own tiling desktop with the glueqs bar: windows arrange themselves, with smooth animations, three layouts (bsp, scroll, drift) on one key, a launcher, notifications and a settings panel. The default Glue session.",
      "ease": 4,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal (alacritty)"
        },
        {
          "keys": "Super+Space",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+c",
          "action": "Close focused window"
        },
        {
          "keys": "Super",
          "action": "Open the overview (tap Super alone)"
        },
        {
          "keys": "Super+←↑↓→",
          "action": "Move focus left/down/up/right"
        },
        {
          "keys": "Super+Shift+←↑↓→",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+v",
          "action": "Toggle floating (centered)"
        },
        {
          "keys": "Super+n",
          "action": "Cycle layout (bsp / scroll / drift)"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+s",
          "action": "Screenshot a region to the clipboard"
        },
        {
          "keys": "Super+Shift+F1",
          "action": "Show Welcome and shortcuts"
        }
      ],
      "screenshots": [
        "screenshots/gluewc-glueqs-bar.png",
        "screenshots/gluewc-glueqs-overview.png"
      ],
      "packages": [
        "gluewc",
        "rofi",
        "polkit-gnome",
        "nautilus"
      ],
      "services": [],
      "shell_choices": [
        "glueqs"
      ],
      "session_type": "wayland",
      "exec": "gluewc-session",
      "idle_ram": "about 450 MB"
    },
    {
      "id": "gluewc-noctalia",
      "name": "gluewc + Noctalia",
      "kind": "wm",
      "description": "The same gluewc tiling desktop with the Noctalia shell instead of glueqs: a polished bar, a control center and widgets from the Noctalia project. A bit heavier than glueqs.",
      "ease": 4,
      "lightness": 4,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal (alacritty)"
        },
        {
          "keys": "Super+Space",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+c",
          "action": "Close focused window"
        },
        {
          "keys": "Super",
          "action": "Open the overview (tap Super alone)"
        },
        {
          "keys": "Super+←↑↓→",
          "action": "Move focus left/down/up/right"
        },
        {
          "keys": "Super+Shift+←↑↓→",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+v",
          "action": "Toggle floating (centered)"
        },
        {
          "keys": "Super+n",
          "action": "Cycle layout (bsp / scroll / drift)"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+s",
          "action": "Screenshot a region to the clipboard"
        },
        {
          "keys": "Super+Shift+F1",
          "action": "Show Welcome and shortcuts"
        }
      ],
      "screenshots": [
        "screenshots/gluewc-noctalia-bar.png",
        "screenshots/gluewc-noctalia-overview.png"
      ],
      "packages": [
        "gluewc",
        "rofi",
        "polkit-gnome",
        "nautilus"
      ],
      "services": [],
      "shell_choices": [
        "noctalia"
      ],
      "session_type": "wayland",
      "exec": "gluewc-session",
      "desktop": "gluewc",
      "idle_ram": "about 600 MB"
    },
    {
      "id": "nvwm",
      "name": "nvwm",
      "kind": "wm",
      "description": "A tiny X11 tiling window manager with its own bar. The lightest choice here: keyboard-driven, for people who like to tweak.",
      "ease": 3,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal"
        },
        {
          "keys": "Super+d",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+←↑↓→",
          "action": "Focus window left/down/up/right"
        },
        {
          "keys": "Super+Shift+←↑↓→",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+f",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+F1",
          "action": "Show Welcome and shortcuts"
        }
      ],
      "screenshots": [
        "screenshots/nvwm.png"
      ],
      "packages": [
        "nvwm",
        "st-glue",
        "rofi",
        "feh",
        "polkit-gnome",
        "nautilus"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "nvwm",
      "idle_ram": "about 200 MB"
    },
    {
      "id": "kde-plasma",
      "name": "KDE Plasma",
      "kind": "de",
      "description": "A full classic desktop that works like Windows: taskbar, start menu, desktop icons and lots of settings. Best for beginners, and a good backup if tiling is not for you. The heaviest option.",
      "ease": 5,
      "lightness": 2,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal (Konsole)"
        },
        {
          "keys": "Super",
          "action": "Open application launcher"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Snap window left/right"
        },
        {
          "keys": "Super+Up",
          "action": "Maximize window"
        },
        {
          "keys": "Super+Down",
          "action": "Minimize window"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        }
      ],
      "screenshots": [
        "screenshots/kde-plasma.png"
      ],
      "packages": [
        "plasma-meta",
        "dolphin",
        "konsole",
        "tesseract-data-eng"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "startplasma-x11",
      "idle_ram": "about 1 GB"
    },
    {
      "id": "xfce",
      "name": "XFCE",
      "kind": "de",
      "description": "A light classic desktop with a panel, a menu, desktop icons and simple settings. Good for older or low-RAM computers.",
      "ease": 5,
      "lightness": 3,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal (xfce4-terminal)"
        },
        {
          "keys": "Alt+F2",
          "action": "Open run dialog"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Super+d",
          "action": "Show desktop"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Print",
          "action": "Take screenshot"
        }
      ],
      "screenshots": [
        "screenshots/xfce.png"
      ],
      "packages": [
        "xfce4-session",
        "xfce4-panel",
        "xfwm4",
        "xfdesktop",
        "xfce4-settings",
        "thunar",
        "xfce4-terminal",
        "xfce4-power-manager"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "startxfce4",
      "idle_ram": "about 550 MB"
    },
    {
      "id": "gnome",
      "name": "GNOME (minimal)",
      "kind": "de",
      "description": "A clean, modern desktop (minimal install): the Activities overview, a dock, Files and Settings, with no extra apps. Runs on Wayland and supports touchpad gestures.",
      "ease": 5,
      "lightness": 2,
      "keybindings": [
        {
          "keys": "Super",
          "action": "Activities overview (launcher + windows)"
        },
        {
          "keys": "Super+A",
          "action": "Show all applications"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Super+Up",
          "action": "Maximize window"
        },
        {
          "keys": "Super+PageUp/PageDown",
          "action": "Switch workspace"
        }
      ],
      "screenshots": [
        "screenshots/gnome.png"
      ],
      "packages": [
        "gnome-shell",
        "gnome-session",
        "gnome-session-sysvinit",
        "gnome-console",
        "nautilus",
        "gnome-control-center",
        "gnome-backgrounds",
        "xdg-user-dirs"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "wayland",
      "exec": "gnome-session",
      "desktop": "GNOME",
      "idle_ram": "about 1 GB"
    },
    {
      "id": "cinnamon",
      "name": "Cinnamon",
      "kind": "de",
      "description": "A classic desktop like Linux Mint's: start menu, panel and system tray. Familiar and friendly, medium weight.",
      "ease": 5,
      "lightness": 3,
      "keybindings": [
        {
          "keys": "Ctrl+Alt+T",
          "action": "Open terminal"
        },
        {
          "keys": "Super",
          "action": "Open the menu"
        },
        {
          "keys": "Alt+F4",
          "action": "Close window"
        },
        {
          "keys": "Alt+Tab",
          "action": "Switch windows"
        },
        {
          "keys": "Super+Left/Right",
          "action": "Tile window left/right"
        },
        {
          "keys": "Super+D",
          "action": "Show desktop"
        }
      ],
      "screenshots": [
        "screenshots/cinnamon.png"
      ],
      "packages": [
        "cinnamon",
        "cinnamon-translations",
        "cinnamon-session",
        "nemo",
        "gnome-terminal",
        "xdg-user-dirs"
      ],
      "services": [],
      "shell_choices": [],
      "session_type": "x11",
      "exec": "cinnamon-session",
      "idle_ram": "about 750 MB"
    }
  ],
  "shells": [
    {
      "id": "glueqs",
      "name": "glueqs",
      "description": "Glue's own desktop shell: bar, launcher, notifications and a settings panel, made for gluewc. Recommended.",
      "ease": 5,
      "lightness": 4,
      "keybindings": [],
      "screenshots": [
        "screenshots/gluewc-glueqs-bar.png",
        "screenshots/gluewc-glueqs-overview.png"
      ],
      "packages": [
        "glueqs"
      ],
      "exec": "glueqs"
    },
    {
      "id": "noctalia",
      "name": "Noctalia Shell",
      "description": "A polished shell and bar for Wayland compositors, from the Noctalia project.",
      "ease": 4,
      "lightness": 4,
      "keybindings": [
        {
          "keys": "Super+b",
          "action": "Toggle bar visibility"
        },
        {
          "keys": "Super+n",
          "action": "Open notification center"
        },
        {
          "keys": "Super+m",
          "action": "Open media controls"
        },
        {
          "keys": "Super+s",
          "action": "Open system settings panel"
        },
        {
          "keys": "Super+Shift+b",
          "action": "Reload bar configuration"
        }
      ],
      "screenshots": [
        "screenshots/gluewc-noctalia-bar.png",
        "screenshots/gluewc-noctalia-overview.png"
      ],
      "packages": [
        "noctalia-shell",
        "noctalia-qs"
      ],
      "exec": "qs -c noctalia-shell"
    }
  ],
  "support": [
    {
      "id": "app-store",
      "name": "App store (Pacman + Flathub + AUR)",
      "description": "Glue Apps finds, installs and updates apps from the system repositories, Flathub and the AUR (through yay). Recommended.",
      "packages": [
        "flatpak",
        "yay",
        "artixlinux-appstream-data",
        "pacman-contrib"
      ],
      "services": [],
      "default": true
    },
    {
      "id": "bluetooth",
      "name": "Bluetooth Support",
      "description": "Installs the Bluetooth stack (BlueZ) and Blueman for easy pairing.",
      "packages": [
        "bluez",
        "bluez-utils",
        "blueman"
      ],
      "services": [
        "bluetoothd"
      ],
      "default": false
    }
  ],
  "gaming": {
    "name": "Gaming Mode",
    "description": "Prepares the system for gaming out of the box: Steam with Proton (the CachyOS build, plus Proton GE), Heroic, Lutris, Wine with winetricks and protontricks, 32- and 64-bit Vulkan, GameMode, MangoHud with GOverlay, Gamescope, a sched_ext CPU scheduler and ananicy-cpp process priorities. Graphics drivers are detected and installed automatically.",
    "packages": [
      "steam",
      "heroic-games-launcher-bin",
      "proton-ge-custom-bin",
      "proton-cachyos-slr",
      "umu-launcher",
      "ntsync-autoload",
      "firefox",
      "vulkan-icd-loader",
      "lib32-vulkan-icd-loader",
      "lib32-mesa",
      "lib32-pipewire",
      "gamemode",
      "lib32-gamemode",
      "mangohud",
      "gamescope",
      "lm_sensors",
      "ananicy-cpp",
      "cachyos-ananicy-rules",
      "lib32-mangohud",
      "wine-cachyos-opt",
      "lutris",
      "goverlay",
      "protontricks",
      "winetricks",
      "vulkan-tools",
      "ttf-liberation",
      "wqy-zenhei",
      "openal",
      "giflib",
      "glfw",
      "mpg123",
      "gst-plugins-base-libs",
      "libxslt",
      "lib32-alsa-plugins",
      "lib32-gtk3",
      "lib32-libva",
      "lib32-ocl-icd",
      "lib32-libjpeg-turbo"
    ],
    "services": [
      "ananicy-cpp"
    ],
    "gpu_autodetect": true,
    "schedulers": [
      {
        "id": "scx_lavd",
        "name": "scx_lavd",
        "description": "Latency-aware sched_ext scheduler tuned for gaming; runs with --performance. The CachyOS default.",
        "default": true
      },
      {
        "id": "scx_bpfland",
        "name": "scx_bpfland",
        "description": "sched_ext scheduler that prioritizes interactive tasks — UI and audio stay smooth under load.",
        "default": false
      },
      {
        "id": "none",
        "name": "None",
        "description": "No userspace scheduler: keep the kernel's built-in EEVDF scheduler.",
        "default": false
      }
    ]
  },
  "minimal": {
    "name": "Minimal Install",
    "description": "Bare system with no window manager or desktop environment preselected. You get a bootable base with the essentials — shell, network tools, and package manager — and build from there yourself."
  }
}
