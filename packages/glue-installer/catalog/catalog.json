        {
          "keys": "Ctrl+Cmd+F",
          "action": "Toggle full screen"
        },
        {
          "keys": "Ctrl+↑ or F3",
          "action": "Mission Control (or swipe up with three fingers)"
        },
        {
          "keys": "Ctrl+←/→",
