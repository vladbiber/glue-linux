{
  "version": 1,
  "kernels": [
    {
      "id": "linux-cachyos",
      "name": "CachyOS Kernel",
      "description": "The kernel tuned for speed, with the BORE scheduler and the CachyOS patches. The default for Glue Linux.",
      "packages": [
        "linux-cachyos",
        "linux-cachyos-headers"
      ],
      "primary": true
    },
    {
      "id": "linux-zen",
      "name": "Zen Kernel",
      "description": "A community kernel tuned for a responsive desktop. A good second choice.",
      "packages": [
        "linux-zen",
        "linux-zen-headers"
      ],
      "primary": false
    }
  ],
  "inits": [
    {
      "id": "dinit",
      "name": "dinit",
      "description": "Fast and simple, with quick boot times. The default for Glue Linux.",
      "packages": [
        "dinit"
      ],
      "recommended": true
    },
    {
      "id": "runit",
      "name": "runit",
      "description": "Small and proven over many years. Void Linux uses it.",
      "packages": [
        "runit"
      ],
      "recommended": false
    },
    {
      "id": "openrc",
      "name": "OpenRC",
      "description": "Mature and well documented. Gentoo uses it.",
      "packages": [
        "openrc"
      ],
      "recommended": false
    }
  ],
  "sessions": [
    {
      "id": "gluewc",
      "name": "gluewc + glueqs",
      "kind": "wm",
      "description": "Glue's own tiling desktop with the glueqs bar: windows arrange themselves, with smooth animations, three layouts (bsp, scroll, drift) on one key, a launcher, notifications and a settings panel. The default Glue session.",
      "ease": 4,
      "lightness": 5,
      "keybindings": [
        {
          "keys": "Super+Return",
          "action": "Open terminal (alacritty)"
        },
        {
          "keys": "Super+Space",
          "action": "Open application launcher"
        },
        {
          "keys": "Super+Q",
          "action": "Close focused window"
        },
        {
          "keys": "Super+F",
          "action": "Toggle fullscreen"
        },
        {
          "keys": "Super+V",
          "action": "Toggle floating"
        },
        {
          "keys": "Super+E",
          "action": "Open file manager"
        },
        {
          "keys": "Super+B",
          "action": "Open web browser"
        },
        {
          "keys": "Super+1-9",
          "action": "Switch to workspace 1-9"
        },
        {
          "keys": "Super+Shift+1-9",
          "action": "Move window to workspace 1-9"
        },
        {
          "keys": "Super+L",
          "action": "Lock the screen"
        },
        {
          "keys": "Super+Shift+S",
          "action": "Screenshot a region to the clipboard"
        },
        {
          "keys": "Print",
          "action": "Screenshot"
        },
        {
          "keys": "Ctrl+Alt+Delete",
          "action": "Session menu (lock, log out, restart, shut down)"
        },
        {
          "keys": "Super+Shift+F1",
          "action": "Show Welcome and shortcuts"
        },
        {
          "keys": "Super",
          "action": "Open the overview (tap Super alone)"
        },
        {
          "keys": "Super+←↑↓→",
          "action": "Move focus left/down/up/right"
        },
        {
          "keys": "Super+Shift+←↑↓→",
          "action": "Swap window left/down/up/right"
        },
        {
          "keys": "Super+Ctrl+1-9",
          "action": "Move window to workspace 1-9 and follow it"
        },
        {
          "keys": "Super+N",
          "action": "Cycle layout (bsp / scroll / drift)"
        }
      ],
      "screenshots": [
        "screenshots/gluewc-glueqs-bar.png",
        "screenshots/gluewc-glueqs-launcher.png",
        "screenshots/gluewc-glueqs-overview.png",
        "screenshots/gluewc-glueqs-calendar.png",
        "screenshots/gluewc-glueqs-notifications.png",
        "screenshots/gluewc-glueqs-settings.png",
        "screenshots/gluewc-glueqs-colors.png",
        "screenshots/gluewc-glueqs-colors-bar.png",
        "screenshots/gluewc-glueqs-font.png",
        "screenshots/gluewc-glueqs-fonts.png",
        "screenshots/gluewc-glueqs-wallpapers.png"
      ],
      "packages": [
        "gluewc",
        "rofi",
        "polkit-gnome",
        "nautilus",
        "loupe",
        "celluloid",
        "papers"
      ],
      "services": [],
      "shell_choices": [
        "glueqs"
      ],
      "session_type": "wayland",
      "exec": "gluewc-session",
      "idle_ram": "about 230 MB",
      "disk": "about 500 MB"
    },
