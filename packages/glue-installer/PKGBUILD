# Maintainer: Glue Linux
pkgname=glue-installer
pkgver=1
pkgrel=33
pkgdesc="Glue Linux TUI installer (Python curses, catalog-driven)"
arch=('any')
url="https://github.com/vladbiber/glue-linux"
license=('MIT')
depends=('python' 'artools-base' 'gptfdisk' 'dosfstools' 'e2fsprogs'
         'grub' 'efibootmgr' 'util-linux')
optdepends=('chafa: previews session screenshots in the TUI (P key)')
# glue-install launcher and pacman.conf are staged next to this PKGBUILD
# by scripts/make-iso.sh — makepkg won't resolve ../../ relative source paths.
source=('glue-install'
        'pacman.conf')
sha256sums=('SKIP' 'SKIP')

package() {
    # Launcher
    install -Dm755 "$srcdir/glue-install" "$pkgdir/usr/bin/glue-install"

    # pacman.conf (repos: artix + cachyos + glue) for pacstrap -C
    install -Dm644 "$srcdir/pacman.conf" "$pkgdir/usr/share/glue/pacman.conf"

    # Python module (all .py files from the package dir, no tests or __pycache__)
    local moddir="$pkgdir/usr/lib/glue-installer/glue_installer"
    install -dm755 "$moddir"
    find "$startdir/glue_installer" -maxdepth 1 -name '*.py' | while read -r f; do
        install -Dm644 "$f" "$moddir/$(basename "$f")"
    done

    # Catalog JSON
    install -Dm644 "$startdir/catalog/catalog.json" \
        "$pkgdir/usr/share/glue-installer/catalog/catalog.json"

    # Screenshots (may be empty directory — tolerate gracefully)
    if [ -d "$startdir/catalog/screenshots" ]; then
        find "$startdir/catalog/screenshots" -type f | while read -r f; do
            rel="${f#$startdir/catalog/screenshots/}"
            install -Dm644 "$f" \
                "$pkgdir/usr/share/glue-installer/catalog/screenshots/$rel"
        done
    fi
}
