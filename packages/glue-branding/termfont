#!/usr/bin/env bash
# termfont - persistently grow/shrink the alacritty font
#
#   termfont                  # show the current size
#   termfont +1               # bigger by 1
#   termfont -2               # smaller by 2
#   termfont alacritty 12     # set an exact size
#   termfont reset            # back to 11

set -u

ALA_CONF="$HOME/.config/alacritty/alacritty.toml"
ALA_SYSTEM="/etc/xdg/alacritty/alacritty.toml"
MIN=4
MAX=72
ALA_DEFAULT=11

die() { echo "termfont: $*" >&2; exit 1; }

clamp() { # $1 = float
    awk -v v="$1" -v lo="$MIN" -v hi="$MAX" \
        'BEGIN { if (v < lo) v = lo; if (v > hi) v = hi; printf "%.1f\n", v }'
}

get_alacritty() {
    local v
    v=$(awk '
        /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\][[:space:]]*$/) }
        in_font && /^[[:space:]]*size[[:space:]]*=/ { gsub(/[^0-9.]/, "", $0); v = $0 }
        END { print v }
    ' "$ALA_CONF" 2>/dev/null)
    [ -n "$v" ] || v=11.25  # alacritty built-in default
    clamp "$v"
}

set_alacritty() {
    local new="$1"
    if [ ! -f "$ALA_CONF" ]; then
        mkdir -p "$(dirname "$ALA_CONF")"
        if [ -f "$ALA_SYSTEM" ]; then cp "$ALA_SYSTEM" "$ALA_CONF"; else : > "$ALA_CONF"; fi
    fi
    if awk '/^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\][[:space:]]*$/) }
            in_font && /^[[:space:]]*size[[:space:]]*=/ { found = 1 }
            END { exit !found }' "$ALA_CONF"; then
        # replace only the size inside the [font] section
        awk -v new="$new" '
            /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\][[:space:]]*$/) }
            in_font && /^[[:space:]]*size[[:space:]]*=/ && !done { print "size = " new; done = 1; next }
            { print }
        ' "$ALA_CONF" > "$ALA_CONF.tmp" && mv "$ALA_CONF.tmp" "$ALA_CONF"
    elif grep -qE '^[[:space:]]*\[font\][[:space:]]*$' "$ALA_CONF"; then
        sed -i -E "0,/^[[:space:]]*\[font\][[:space:]]*$/s//[font]\nsize = $new/" "$ALA_CONF"
    else
        printf '\n[font]\nsize = %s\n' "$new" >> "$ALA_CONF"
    fi
    # alacritty reloads its config live, so open windows pick this up
    echo "alacritty  -> $new"
}

apply() { # $1 = spec
    local spec="$1" cur new
    cur=$(get_alacritty)
    case "$spec" in
        show) printf '%-10s %s\n' alacritty "$cur"; return ;;
        reset) new="$ALA_DEFAULT" ;;
        [+-]*) new=$(awk -v c="$cur" -v d="${spec#[+-]}" -v s="${spec%%[0-9.]*}" \
                    'BEGIN { print (s == "-") ? c - d : c + d }') ;;
        *)     new="$spec" ;;
    esac
    case "$new" in ''|*[!0-9.]*) die "invalid size: $spec" ;; esac
    set_alacritty "$(clamp "$new")"
}

spec="show"

case "${1-}" in
    alacritty)    spec="${2-show}" ;;
    kitty)        die "only alacritty is supported" ;;
    -h|--help)    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    "")           spec="show" ;;
    *)            spec="$1" ;;
esac

apply "$spec"
