# Maintainer: Glue Linux
pkgname=glue-branding
pkgver=1
pkgrel=11
pkgdesc="Glue Linux branding, default wallpaper and boot theme"
arch=('any')
url="https://github.com/Vifuddyxg"
license=('MIT' 'CC0-1.0')
optdepends=('fastfetch: system info splash with the Glue logo'
            'alacritty: default terminal with the Glue config'
            'ttf-liberation: terminal font (Liberation Mono)'
            'rofi: fullscreen application launcher'
            'glue-zsh: default terminal shell with Oh My Zsh')
backup=('etc/glue/fastfetch.jsonc' 'etc/xdg/fastfetch/config.jsonc' 'etc/xdg/alacritty/alacritty.toml' 'etc/rofi.rasi')
install='glue-branding.install'
source=('logo.txt' 'fastfetch.jsonc' 'term-neutral.sh'
        'grub-theme.txt' 'grub-background.png' 'grub-icon.png'
        'os-release' 'issue'
        'palette.sh' 'palette.json'
        'wallpaper.png' 'WALLPAPER-CREDITS.md' 'glue-wallpaper-init'
        'alacritty.toml' 'termfont'
        'rofi.rasi' 'rofi-fullscreen-preview.rasi')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            '29986d12aa6b234ed72eead6d7fcfb1740ac847dc9812e92b446bfd7fe5ca4ca'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # ----- fastfetch logo + config -----
    install -Dm644 "$srcdir/logo.txt"       "$pkgdir/usr/share/glue/logo.txt"
    install -Dm644 "$srcdir/fastfetch.jsonc" "$pkgdir/etc/glue/fastfetch.jsonc"
    install -Dm644 "$srcdir/term-neutral.sh" "$pkgdir/usr/share/glue/term-neutral.sh"

    # ship fastfetch config in /etc/skel so every new user picks up the logo automatically
    install -Dm644 "$srcdir/fastfetch.jsonc" "$pkgdir/etc/skel/.config/fastfetch/config.jsonc"
    # fastfetch also searches /etc/xdg/fastfetch: the Glue logo survives a user
    # deleting ~/.config/fastfetch
    install -Dm644 "$srcdir/fastfetch.jsonc" "$pkgdir/etc/xdg/fastfetch/config.jsonc"

    # ----- alacritty: Glue config (skel for new users, /etc/xdg for the rest)
    #       + termfont, which Ctrl+Shift +/-/Backspace call -----
    install -Dm644 alacritty.toml "$pkgdir/etc/skel/.config/alacritty/alacritty.toml"
    install -Dm644 alacritty.toml "$pkgdir/etc/xdg/alacritty/alacritty.toml"
    install -Dm755 termfont "$pkgdir/usr/bin/termfont"

    # Rofi uses /etc/rofi.rasi as its system config; skel covers new users.
    install -Dm644 rofi.rasi "$pkgdir/etc/rofi.rasi"
    install -Dm644 rofi.rasi "$pkgdir/etc/skel/.config/rofi/config.rasi"
    install -Dm644 rofi-fullscreen-preview.rasi "$pkgdir/usr/share/glue/rofi/fullscreen-preview.rasi"

    # ----- amber palette (single source of truth for Hub, installer, regreet, Limine) -----
    install -Dm644 "$srcdir/palette.sh"   "$pkgdir/usr/share/glue/palette.sh"
    install -Dm644 "$srcdir/palette.json" "$pkgdir/usr/share/glue/palette.json"

    # ----- default wallpaper (approved for greeter and desktop sessions) -----
    install -Dm644 "$srcdir/wallpaper.png" \
        "$pkgdir/usr/share/backgrounds/glue/wallpaper.png"
    install -Dm644 "$srcdir/WALLPAPER-CREDITS.md" \
        "$pkgdir/usr/share/licenses/glue-branding/WALLPAPER-CREDITS.md"
    install -Dm755 "$srcdir/glue-wallpaper-init" \
        "$pkgdir/usr/bin/glue-wallpaper-init"
    # useradd copies this marker; the login wrapper removes it after applying
    # the default once, so later wallpaper choices remain untouched.
    install -Dm644 /dev/null \
        "$pkgdir/etc/skel/.local/state/glue/wallpaper-pending"

    # ----- os-release (staged; the .install scriptlet copies it to
    #       /usr/lib/os-release, which is owned by the filesystem package) -----
    install -Dm644 "$srcdir/os-release" "$pkgdir/usr/share/glue/os-release"

    # ----- issue with the Glue banner (agetty \e escape notation); staged,
    #       the .install scriptlet copies it to /etc/issue (owned by filesystem) -----
    install -Dm644 "$srcdir/issue" "$pkgdir/usr/share/glue/issue"

    # ----- GRUB theme (amber Glue) — the installer points the target's
    #       /etc/default/grub at this via GRUB_THEME. The icon name matches
    #       the menu-entry class grub-mkconfig derives from
    #       GRUB_DISTRIBUTOR="Glue Linux" (first word, lowercased). -----
    install -Dm644 "$srcdir/grub-theme.txt" \
        "$pkgdir/usr/share/grub/themes/glue/theme.txt"
    install -Dm644 "$srcdir/grub-background.png" \
        "$pkgdir/usr/share/grub/themes/glue/background.png"
    install -Dm644 "$srcdir/grub-icon.png" \
        "$pkgdir/usr/share/grub/themes/glue/icons/glue.png"
}
