#!/bin/sh
# Apply Glue's packaged wallpaper once per desktop for a newly-created user.
# The marker comes from /etc/skel and stays; every session/shell pair that got
# the default is listed in wallpaper-done, so each desktop gets it on its first
# login and later user choices are never overwritten.
set -u

session=${1:-}
shell=${2:-none}
case "$session" in
    gluemac*) default=/usr/share/backgrounds/glue/glue-mac.jpg ;;
    *) default=/usr/share/backgrounds/glue/wallpaper.png ;;
esac
wallpaper=${GLUE_WALLPAPER_PATH:-$default}
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/glue
marker=$state_dir/wallpaper-pending
done_list=$state_dir/wallpaper-done
key="$session:$shell"
retries=${GLUE_WALLPAPER_RETRIES:-150}

[ -f "$marker" ] || exit 0
grep -qxF "$key" "$done_list" 2>/dev/null && exit 0
[ -r "$wallpaper" ] || exit 1

run_until_ok() {
    left=$retries
    while [ "$left" -gt 0 ]; do
        "$@" >/dev/null 2>&1 && return 0
        left=$((left - 1))
        [ "$left" -gt 0 ] && sleep 0.2
    done
    return 1
}

set_xfce() {
    props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null) || return 1
    found=0
    for prop in $props; do
        case "$prop" in
            */last-image)
                xfconf-query -c xfce4-desktop -p "$prop" -s "$wallpaper" || return 1
                found=1
                ;;
        esac
    done
    [ "$found" -eq 1 ]
}

# xfdesktop names monitors after the output (monitorVirtual-1, monitoreDP-1)
set_xfce_outputs() {
    outputs=$(xrandr --listmonitors 2>/dev/null | awk 'NR > 1 { print $NF }')
    [ -n "$outputs" ] || outputs=0
    for out in $outputs; do
        for ws in 0 1 2 3; do
            xfconf-query -c xfce4-desktop \
                -p "/backdrop/screen0/monitor$out/workspace$ws/last-image" \
                -n -t string -s "$wallpaper" || return 1
        done
    done
}

ok=1
case "$session:$shell" in
    gluewc*:glueqs)
        run_until_ok qs -c glueqs ipc call glueqs setwallpaper "$wallpaper" || ok=0
        ;;
    gluemac*:gluemac-shell)
        run_until_ok qs -c gluemac-shell ipc call wallpaper change "$wallpaper" || ok=0
        ;;
    gluemac*:macshell|gluewc*:macshell)
        run_until_ok glue-macshell ipc wallpapers set "$wallpaper" || ok=0
        ;;
    gluewc*:caelestia)
        run_until_ok caelestia wallpaper -f "$wallpaper" || ok=0
        ;;
    hyprland*:ii)
        switchwall=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/ii/scripts/colors/switchwall.sh
        export ILLOGICAL_IMPULSE_VIRTUAL_ENV=/usr/lib/ii-vynx/venv
        run_until_ok qs -c ii ipc show || ok=0
        [ "$ok" -eq 1 ] && { "$switchwall" --image "$wallpaper" >/dev/null 2>&1 || ok=0; }
        ;;
    gluewc*:noctalia)
        run_until_ok noctalia msg wallpaper-set "$wallpaper" || ok=0
        ;;
    nvwm:*)
        run_until_ok feh --no-fehbg --bg-fill "$wallpaper" || ok=0
        ;;
    kde-plasma:*)
        run_until_ok plasma-apply-wallpaperimage "$wallpaper" || ok=0
        ;;
    xfce:*)
        run_until_ok set_xfce || set_xfce_outputs || ok=0
        ;;
    gnome:*)
        uri="file://$wallpaper"
        gsettings set org.gnome.desktop.background picture-uri "$uri" &&
        gsettings set org.gnome.desktop.background picture-uri-dark "$uri" &&
        gsettings set org.gnome.desktop.background picture-options zoom || ok=0
        ;;
    cinnamon:*)
        uri="file://$wallpaper"
        gsettings set org.cinnamon.desktop.background picture-uri "$uri" &&
        gsettings set org.cinnamon.desktop.background picture-options zoom || ok=0
        ;;
    *)
        ok=0
        ;;
esac

if [ "$ok" -eq 1 ]; then
    printf '%s\n' "$key" >> "$done_list"
    exit 0
fi
exit 1
