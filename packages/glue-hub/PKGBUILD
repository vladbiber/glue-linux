# Maintainer: Glue Linux
pkgname=glue-hub
pkgver=0.1.0
pkgrel=1
pkgdesc="Glue Linux control center and application store"
arch=('any')
url="https://github.com/vladbiber/glue-linux"
license=('GPL-3.0-only')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit')
optdepends=('flatpak: Flathub applications'
            'yay: AUR applications'
            'artixlinux-appstream-data: native application metadata'
            'pacman-contrib: update availability checks'
            'lm_sensors: temperature information')
source=('glue-hub' 'pkg.sh' 'update.sh' 'org.glue.hub.policy')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/glue-hub" "$pkgdir/usr/bin/glue-hub"
    install -Dm755 "$srcdir/pkg.sh" "$pkgdir/usr/lib/glue-hub/pkg.sh"
    install -Dm755 "$srcdir/update.sh" "$pkgdir/usr/lib/glue-hub/update.sh"
    install -Dm644 "$srcdir/org.glue.hub.policy" \
        "$pkgdir/usr/share/polkit-1/actions/org.glue.hub.policy"

    local moddir="$pkgdir/usr/lib/glue-hub/glue_hub"
    install -dm755 "$moddir"
    find "$startdir/glue_hub" -maxdepth 1 -name '*.py' | while read -r file; do
        install -Dm644 "$file" "$moddir/$(basename "$file")"
    done

    install -Dm644 "$startdir/data/applications/org.glue.Hub.desktop" \
        "$pkgdir/usr/share/applications/org.glue.Hub.desktop"
    install -Dm644 "$startdir/data/autostart/org.glue.Hub.desktop" \
        "$pkgdir/etc/xdg/autostart/org.glue.Hub.desktop"
    install -Dm644 "$startdir/data/icons/org.glue.Hub.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.glue.Hub.svg"
    install -Dm644 "$startdir/data/default.conf" "$pkgdir/etc/glue/hub.conf"
    find "$startdir/data/themes" -type f | while read -r file; do
        rel="${file#$startdir/data/}"
        install -Dm644 "$file" "$pkgdir/usr/share/glue-hub/$rel"
    done
    install -Dm644 "$startdir/../glue-installer/catalog/catalog.json" \
        "$pkgdir/usr/share/glue/catalog.json"
}
