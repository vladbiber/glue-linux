<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Glue Linux</vendor>
  <vendor_url>https://github.com/vladbiber/glue-linux</vendor_url>
  <action id="org.glue.hub.manage">
    <description>Instalează, elimină sau actualizează aplicații</description>
    <message>Autentifică-te pentru a modifica aplicațiile sistemului</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/glue-hub/pkg.sh</annotate>
  </action>
  <action id="org.glue.hub.update">
    <description>Actualizează Glue Linux</description>
    <message>Autentifică-te pentru a actualiza sistemul</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/glue-hub/update.sh</annotate>
  </action>
</policyconfig>
