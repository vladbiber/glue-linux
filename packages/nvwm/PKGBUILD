# Maintainer: Glue Linux
pkgname=nvwm
pkgver=r36.370f3f5
pkgrel=2
pkgdesc="Light and strong BSP tiling window manager for X11 with built-in per-monitor bar"
arch=('x86_64')
url="https://github.com/Vifuddyxg/nvwm"
license=('custom')
# libpulse/playerctl/brightnessctl: the volume/media/brightness keybinds are
# shipped ENABLED (pactl/playerctl/brightnessctl spawns) - hard deps, not opt
depends=('libx11' 'libxinerama' 'libxrandr' 'libxcomposite' 'libxrender'
         'xorg-xinit' 'dbus' 'libpulse' 'playerctl' 'brightnessctl' 'alacritty')
optdepends=('rofi: application launcher' 'st-glue: terminal'
            'picom: compositor (nvwm ships a picom.conf)'
            'pipewire: audio' 'wireplumber: audio session manager'
            'pipewire-pulse: PulseAudio-compatible audio')
makedepends=('git')
source=("git+https://github.com/Vifuddyxg/nvwm.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/$pkgname"
    # default terminal stays alacritty; st-glue is the fallback
    grep -q '^terminal       = alacritty' config.conf || {
        echo 'ERROR: upstream nvwm config no longer defaults to alacritty' >&2; exit 1; }
    # the volume / media / brightness keys must be ACTIVE however upstream
    # ships them - commented ("# bind_insert"), or enabled behind leading
    # whitespace (" bind_insert", current HEAD). pactl/playerctl/brightnessctl
    # are hard deps of this package so the spawns always work.
    sed -i -E 's/^[[:space:]#]*(bind_insert = XF86)/\1/' config.conf
    grep -q '^bind_insert = mod+F1 = spawn:playerctl play-pause$' config.conf ||
        printf '\nbind_insert = mod+F1 = spawn:playerctl play-pause\n' >> config.conf
    grep -q '^bind_insert = mod+shift+F1 = spawn:glue-welcome$' config.conf ||
        printf '\nbind_insert = mod+shift+F1 = spawn:glue-welcome\n' >> config.conf
    # Glue's shared keybindings (catalog/keybindings.json, ADR-026), as on gluewc
    sed -i -e 's/^bind_insert = mod+q = spawn:alacritty$/bind_insert = mod+q = wm:kill/' \
        -e 's/^bind_insert = mod+Space = spawn:rofi -show drun$/bind_insert = mod+Space = spawn:glue-action launcher/' \
        -e 's/^bind_insert = mod+l = wm:focus_right$/bind_insert = mod+l = spawn:glue-action lock/' \
        config.conf
    sed -i '/^bind_insert = mod+ctrl+9 = wm:move_to_workspace_follow:9$/r /dev/stdin' config.conf <<'EOF'
bind_insert = mod+shift+1 = wm:move_to_workspace:1
bind_insert = mod+shift+2 = wm:move_to_workspace:2
bind_insert = mod+shift+3 = wm:move_to_workspace:3
bind_insert = mod+shift+4 = wm:move_to_workspace:4
bind_insert = mod+shift+5 = wm:move_to_workspace:5
bind_insert = mod+shift+6 = wm:move_to_workspace:6
bind_insert = mod+shift+7 = wm:move_to_workspace:7
bind_insert = mod+shift+8 = wm:move_to_workspace:8
bind_insert = mod+shift+9 = wm:move_to_workspace:9
bind_insert = mod+e = spawn:glue-action files
bind_insert = mod+b = spawn:glue-action browser
bind_insert = mod+shift+s = spawn:glue-action screenshot-region
bind_insert = ctrl+alt+Delete = spawn:glue-action session
EOF
    # every line of the shared table must be in the config as built
    for b in 'mod+Return = spawn:alacritty' \
             'mod+Space = spawn:glue-action launcher' \
             'mod+q = wm:kill' \
             'mod+f = wm:toggle_fullscreen' \
             'mod+v = wm:toggle_float_centered' \
             'mod+e = spawn:glue-action files' \
             'mod+b = spawn:glue-action browser' \
             'mod+9 = wm:workspace:9' \
             'mod+shift+9 = wm:move_to_workspace:9' \
             'mod+l = spawn:glue-action lock' \
             'mod+shift+s = spawn:glue-action screenshot-region' \
             'Print = wm:screenshot' \
             'ctrl+alt+Delete = spawn:glue-action session' \
             'mod+shift+F1 = spawn:glue-welcome'; do
        grep -qxF "bind_insert = $b" config.conf || {
            echo "ERROR: shared keybinding '$b' not in config.conf" >&2; exit 1; }
    done
    # all 8 XF86 binds must be live at column 0 after normalization
    [ "$(grep -c '^bind_insert = XF86' config.conf)" -ge 8 ] || {
        echo "ERROR: XF86 keybind uncomment failed" >&2; exit 1; }
}

build() {
    cd "$srcdir/$pkgname"
    make
}

package() {
    cd "$srcdir/$pkgname"
    # installs the binary and /etc/nvwm/config.conf
    make PREFIX=/usr DESTDIR="$pkgdir" install
    # optional compositor config referenced by nvwm's compositor mode
    install -Dm644 picom.conf "$pkgdir/etc/nvwm/picom.conf"
    # user-editable copy in every new home: nvwm loads
    # ~/.config/nvwm/config.conf LAST (it overrides /etc/nvwm/config.conf)
    install -Dm644 config.conf "$pkgdir/etc/skel/.config/nvwm/config.conf"
    install -Dm644 picom.conf "$pkgdir/etc/skel/.config/nvwm/picom.conf"

    # session wrapper (starts X under a TUI greeter + dbus + audio, matching
    # the apeturewm/atomwm wrappers)
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/nvwm-session" <<'EOF'
#!/bin/sh
# nvwm-session - login session wrapper for greeters / display managers.
# Starts X if launched from a TUI greeter (greetd/tuigreet) with no display,
# then audio (pipewire) + session bus, then the WM.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${NVWM_XSTARTED:-}" ]; then
    NVWM_XSTARTED=1; export NVWM_XSTARTED
    exec startx "$0" -- "vt${XDG_VTNR:-1}"
fi
export XDG_CURRENT_DESKTOP=nvwm
export XDG_SESSION_DESKTOP=nvwm
export XDG_SESSION_TYPE=x11
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
exec dbus-run-session sh -lc '
  command -v pipewire       >/dev/null 2>&1 && pipewire &
  command -v wireplumber    >/dev/null 2>&1 && wireplumber &
  command -v pipewire-pulse >/dev/null 2>&1 && pipewire-pulse &
  exec nvwm
'
EOF

    # xsession entry
    install -Dm644 /dev/stdin "$pkgdir/usr/share/xsessions/nvwm.desktop" <<'EOF'
[Desktop Entry]
Name=nvwm
Comment=BSP tiling window manager with built-in bar
Exec=/usr/bin/nvwm-session
TryExec=/usr/bin/nvwm
Type=XSession
DesktopNames=nvwm
Keywords=tiling;bsp;wm;
EOF

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
